{
  "name": "Chrome Profile Router",
  "identifier": "io.github.chinnsenn.chrome-profile-router",
  "version": "1.0.0",
  "urlSchemes": ["http", "https"],
  "fileAssociations": [
    {
      "name": "HTML document",
      "ext": ["html", "xhtml"],
      "role": "Viewer",
      "uti": "public.html"
    }
  ],
  "macos": {
    "infoPlist": {
      "CFBundleDisplayName": "Chrome Profile Router",
      "CFBundleName": "Chrome Profile Router"
    }
  },
  "out": "build"
}
